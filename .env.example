# calendar-agent — environment template. Copy to `.env` (chmod 600) and fill in.
#   cp .env.example .env
# `.env` is gitignored and must never be committed.
# Comments go on their own line: an inline comment after a value is read differently
# by Docker Compose, Node and the Makefile, and an empty value followed by a comment
# would become the comment inside the container.

# ---- identity ----------------------------------------------------------------
# The owner's first name as written in replies ("Alex is free…", "d'Alex").
OWNER_NAME=Alex
# Optional. Other names people may use for the owner, comma separated, quoted if spaces.
# OWNER_ALIASES="Jo,Joanna Smith"
# Optional. Slack app name, bot handle and slash command, all identical.
# Derived when absent: owner name lowercased, accents stripped, "-calendar-agent".
# BOT_NAME=alex-calendar-agent

# ---- install mode ------------------------------------------------------------
# single: one workspace, SLACK_BOT_TOKEN pasted below, no OAuth, no HTTPS needed.
# multi:  several workspaces through the OAuth installer (needs PUBLIC_BASE_URL
#         over HTTPS, e.g. a Tailscale Serve mapping, and the client credentials).
INSTALL_MODE=single

# ---- network -----------------------------------------------------------------
# Container and host port (also the default everywhere else).
APP_PORT=8400
# Host addresses the port is published on (comma separated, one or two). Loopback
# for a reverse proxy / Tailscale Serve; add the host's Tailscale IP to reach
# the admin at http://<host>:<port> over the tailnet. Never 0.0.0.0.
APP_BIND_ADDRESSES=127.0.0.1
# multi mode only: the HTTPS base URL Slack redirects to after an install.
# Installs must be started from this address (the OAuth state cookie is bound to it).
# PUBLIC_BASE_URL=https://<host>.<tailnet>.ts.net:8445

# ---- slack (api.slack.com/apps → your app) -----------------------------------
# Basic Information → App-Level Tokens (scope connections:write); starts with xapp-
SLACK_APP_TOKEN=
# Optional. Basic Information → App Credentials → Signing Secret. Unused in Socket
# Mode (no HTTP receiver), accepted for a future one.
# SLACK_SIGNING_SECRET=
# OAuth & Permissions → after "Install to Workspace" → Bot User OAuth Token; starts with xoxb-
SLACK_BOT_TOKEN=
# multi mode only (Basic Information → App Credentials; state secret: make key-generate)
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_STATE_SECRET=

# ---- admin and encryption ----------------------------------------------------
# The admin login; long (at least 8 characters).
ADMIN_PASSWORD=
# Encrypts keys and tokens at rest: make key-generate (openssl rand -base64 32)
MASTER_KEY=

# ---- provider keys -----------------------------------------------------------
# Seeded into the encrypted settings store at first boot; afterwards they are
# rotated from the admin Settings (a later edit here is ignored) and can be
# removed from this file. Leave empty to paste them in the admin instead.
# app.cal.com → Settings → Developer → API keys; starts with cal_live_
CALCOM_API_KEY=
# platform.deepseek.com → API keys; starts with sk-
DEEPSEEK_API_KEY=

# ---- misc --------------------------------------------------------------------
# fatal|error|warn|info|debug|trace
LOG_LEVEL=info
# Container, image tag and volume names (one per instance on a host).
COMPOSE_PROJECT_NAME=calendar-agent
# Optional, rarely needed: bind host inside the process (compose sets 0.0.0.0 in the
# container), data directory (compose sets /data), Slack off for admin-only runs.
# APP_HOST=127.0.0.1
# DATA_DIR=./data
# SLACK_ENABLED=true
